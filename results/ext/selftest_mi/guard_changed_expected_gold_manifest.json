fff276761b40"], "ecommerce": [2390, "0779fea2d57b82e6d9c15b046411bbe8"]}, "expected_schema_md5_TESTONLY": "d09e8cf9210a8857e057582c4f094761"}], "items": {"PK1": {"instances": ["k3n", "k3_pk_n_named", "k3_pk_n_dup", "k3_pk_n_pnull", "k3_pk_n_spdup"], "gold_sql": "SELECT CASE WHEN EXISTS (SELECT 1 FROM PresidentMarriage WHERE PresidentName IS NULL OR SpouseName IS NULL) OR EXISTS (SELECT 1 FROM PresidentMarriage GROUP BY PresidentName, SpouseName HAVING COUNT(*) > 1) THEN 'NO' ELSE 'YES' END AS verdict", "g1_shape": "1x1", "expected_gold": {"k3n": [["NO"]], "k3_pk_n_named": [["ZZZ-NOT-THE-GOLD"]], "k3_pk_n_dup": [["NO"]], "k3_pk_n_pnull": [["NO"]], "k3_pk_n_spdup": [["YES"]]}, "empty_gold_on_base_ok": false, "gold_varies": true, "why": "k3n: SpouseName NULL for Buchanan (NO); named: no NULL key, no repeated key (YES); dup (built from named, so it has no NULL): one repeated key value that is not a repeated whole row (NO); pnull (from named): PresidentName NULL in one row (NO); spdup: one SpouseName under two presidents, no repeated pair, no NULL (YES). Uniqueness-only and nullity-only answers, constant YES/NO and catalog-based answers each fail at least one instance (brief 1.3); an answer that checks NULL only in SpouseName fails pnull; uniqueness of SpouseName alone fails spdup."}, "FK1": {"instances": ["k3n", "k3_fk_i_null", "k3_fk_i_orphan"], "gold_sql": "SELECT p.PresidentName, p.PartyName FROM President p WHERE p.PartyName IS NOT NULL AND NOT EXISTS (SELECT 1 FROM Party pa WHERE pa.PartyName = p.PartyName)", "g1_shape": "rows x 2", "expected_gold": {"k3n": [], "k3_fk_i_null": [], "k3_fk_i_orphan": [["Planted President Orphan", "Know Nothing"]]}, "empty_gold_on_base_ok": true, "must_not_be_excluded": true, "gold_varies": true, "why": "new answer format (list the violating rows). The gold is empty on k3n and on k3_fk_i_null (a NULL value of a nullable foreign key is not a violation) and one row on k3_fk_i_orphan; the suite rule that excludes an item whose gold is empty on the run database does not apply to this item."}, "FK2": {"instances": ["k3n", "k3_fk_i_null"], "gold_sql": "SELECT pa.partyname FROM party pa WHERE NOT EXISTS (SELECT 1 FROM president p WHERE p.partyname = pa.partyname)", "g1_shape": "rows x 1", "expected_gold": {"k3n": [["Progressive"], ["Union"]], "k3_fk_i_null": [["Progressive"], ["Union"]]}, "empty_gold_on_base_ok": false, "gold_varies": false, "why": "instance catches the NOT IN NULL trap: on k3_fk_i_null a president has PartyName NULL, so NOT IN (SELECT PartyName FROM President) returns no row while the gold still returns Progressive and Union."}}, "single_instance_items": ["FK3"], "reserve_items": ["FK4"], "provenance": {"recorded_at_ict": "2026-10-14T17:15:27+07:00", "server_version": "16.9 (Homebrew)", "datcollate": "C", "datctype": "C", "provider": "libc", "builder_sha256": "49550be85f53ad5362ed68b39fa4aed46e75913f2287732e63ef72247bd4e692", "db_fingerprint_sha256": "2cd25051ebd1f019181bb0db1cec69b09d2b2aa6cf9a7a7ab32e8b151c1d3d11", "grader_sha256": "e1dedbdced9035ecc1326339b3a1564e250fa746fda75dba79571d3c15d8b511", "manifest_before_sha256": "bab727a21de744267d4bf9cb1c204eeb440c68cd8fe581d13eb3ce69f6b1f6da"}}